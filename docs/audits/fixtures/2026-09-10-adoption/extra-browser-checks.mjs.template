import {createRequire} from 'node:module'
import {writeFile} from 'node:fs/promises'
const require=createRequire(`${process.env.CUI_LIBRARY}/package.json`)
const {chromium}=require('playwright'); const b=await chromium.launch(); const p=await b.newPage({viewport:{width:1280,height:900},timezoneId:'Australia/Melbourne'});p.setDefaultTimeout(7000)
const r={errors:[],checks:{}};p.on('pageerror',e=>r.errors.push(e.message));const check=async(n,fn)=>{try{r.checks[n]=await fn()}catch(e){r.checks[n]={error:e.message};await p.keyboard.press('Escape')}}
await p.goto('http://127.0.0.1:3217/probes');await p.getByRole('heading',{name:'Current main probes'}).waitFor()
await check('destructive-focus',async()=>{const button=p.getByRole('button',{name:'Destructive example'});await button.focus();return button.evaluate(e=>({outline:getComputedStyle(e).outlineColor,width:getComputedStyle(e).outlineWidth,offset:getComputedStyle(e).outlineOffset,surface:getComputedStyle(e.closest('article')).backgroundColor,focusVisible:e.matches(':focus-visible')}))})
await check('columns-axe',async()=>{await p.getByRole('button',{name:'Configure columns',exact:true}).click();await p.addScriptTag({path:process.env.CUI_LIBRARY+'/node_modules/.pnpm/axe-core@4.13.0/node_modules/axe-core/axe.min.js'});const result=await p.evaluate(async()=>{const r=await axe.run(document,{runOnly:{type:'tag',values:['wcag2a','wcag2aa','wcag21aa','wcag22aa']}});return r.violations.map(v=>({id:v.id,nodes:v.nodes.map(n=>({target:n.target,summary:n.failureSummary}))}))});await p.keyboard.press('Escape');return result})
await check('date-short-viewport',async()=>{
await p.setViewportSize({width:1280,height:700});const trigger=p.getByRole('button',{name:'Audit date',exact:true});await trigger.evaluate(e=>e.scrollIntoView({block:'center'}));await trigger.click();const input=p.getByRole('textbox',{name:'Enter date',exact:true});await input.fill('2026-09-31');const invalid=await p.getByRole('button',{name:'Apply',exact:true}).isDisabled();await input.fill('2026-10-04');const rect=await p.locator('.cui-date-panel').boundingBox();await p.getByRole('button',{name:'Apply',exact:true}).click();return {invalid,rect,date:await trigger.textContent()}})
await check('reduced-motion',async()=>{await p.emulateMedia({reducedMotion:'reduce'});return p.locator('.cui-progress-indeterminate').evaluate(e=>({animation:getComputedStyle(e).animationName,transition:getComputedStyle(e).transitionDuration}))})
await p.goto('http://127.0.0.1:3217/');await p.getByRole('heading',{name:'Independent adoption fixture'}).waitFor()
await check('table-filter-and-recovery',async()=>{const s=p.getByRole('searchbox',{name:'Search table'});await s.fill('nothing-matches');await p.getByText('No matching results').waitFor();await p.getByRole('button',{name:'Clear search'}).click();return {rows:await p.locator('tbody tr').count(),focusReturned:await s.evaluate(e=>e===document.activeElement),hiddenLegacyNav:await p.locator('.cui-table-pagination').evaluate(e=>getComputedStyle(e).display)}})
await check('select-keyboard',async()=>{const s=p.getByRole('combobox',{name:'View',exact:true});await s.focus();await s.press('Space');await p.keyboard.press('ArrowDown');await p.keyboard.press('Enter');return s.textContent()})
await check('dialog-theme-keyboard',async()=>{await p.getByRole('button',{name:'Toggle theme'}).click();await p.waitForTimeout(200);await p.getByRole('button',{name:'Review action'}).click();const d=p.getByRole('alertdialog');const theme=await d.getAttribute('data-cui-theme');await p.keyboard.press('Escape');await d.waitFor({state:'hidden'});await p.waitForTimeout(100);return {theme,focusReturned:await p.getByRole('button',{name:'Review action'}).evaluate(e=>e===document.activeElement)}})
await check('host-control-isolation',async()=>p.getByTestId('host-control').evaluate(e=>({padding:getComputedStyle(e).padding,border:getComputedStyle(e).borderColor})))
await check('mobile-baseline',async()=>{await p.setViewportSize({width:320,height:800});return p.evaluate(()=>({width:innerWidth,scrollWidth:document.documentElement.scrollWidth}))})
await writeFile('./audit-results/extra-browser-results.json',JSON.stringify(r,null,2));console.log(JSON.stringify(r,null,2));await b.close()
