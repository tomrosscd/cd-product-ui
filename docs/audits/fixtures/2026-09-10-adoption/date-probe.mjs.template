import{createRequire}from'node:module';import{writeFile}from'node:fs/promises';const{chromium}=createRequire(`${process.env.CUI_LIBRARY}/package.json`)('playwright');const b=await chromium.launch();const p=await b.newPage({viewport:{width:1280,height:700},timezoneId:'Australia/Melbourne'});await p.goto('http://127.0.0.1:3217/probes');const t=p.getByRole('button',{name:'Audit date',exact:true});await t.evaluate(e=>e.scrollIntoView({block:'center'}));await t.click();const input=p.getByRole('textbox',{name:'Enter date',exact:true});await input.fill('2026-10-04');const read=async()=>p.locator('.cui-date-panel').evaluate(e=>({panel:e.getBoundingClientRect().toJSON(),available:getComputedStyle(e).getPropertyValue('--radix-popover-content-available-height'),max:getComputedStyle(e).maxHeight,scrollTop:e.scrollTop,scrollHeight:e.scrollHeight,clientHeight:e.clientHeight,buttons:[...e.querySelectorAll('button')].slice(-3).map(e=>({text:e.textContent,rect:e.getBoundingClientRect().toJSON()})),viewport:innerHeight,scrollY}));const r={before:await read()};try{await p.getByRole('button',{name:'Apply',exact:true}).click({timeout:2000});r.clicked=true}catch(e){r.clicked=false;r.after=await read();await p.screenshot({path:'./audit-results/date-clipped.png'});await input.press('Tab');await p.keyboard.press('Tab');await p.keyboard.press('Tab');r.focus=await p.evaluate(()=>document.activeElement.textContent);await p.keyboard.press('Enter');r.keyboardResult=await t.textContent()};console.log(JSON.stringify(r,null,2));await writeFile('./audit-results/date-probe.json',JSON.stringify(r,null,2));await b.close()
