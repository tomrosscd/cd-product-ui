{
  "name": "@convert/product-ui",
  "version": "0.4.0",
  "description": "Convert product foundations and React components for dashboards and internal tools",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "files": [
    "dist",
    "docs/architecture.md",
    "docs/ai-guidance.md",
    "docs/release-process.md",
    "docs/validation.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "docs/component-catalogue.md",
    "assets/brand",
    "docs/release-0.3.md",
    "docs/release-0.4.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./assets/brand/*": "./assets/brand/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "styles": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "build": "pnpm tokens && tsc -p tsconfig.build.json && pnpm styles && node scripts/copy-tokens.mjs",
    "storybook": "pnpm tokens && storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "pnpm tokens && storybook build --disable-telemetry",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:coverage": "vitest run --coverage",
    "api:check": "pnpm build && api-extractor run --print-api-report-diff -c api-extractor.json && api-extractor run --print-api-report-diff -c api-extractor.tokens.json && api-extractor run --print-api-report-diff -c api-extractor.charts.json",
    "api:update": "pnpm build && api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.tokens.json && api-extractor run --local -c api-extractor.charts.json",
    "check": "pnpm tokens:check && pnpm type-check && pnpm lint && pnpm test && pnpm build && pnpm build-storybook",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "next:check": "node scripts/check-next.mjs",
    "test:dark": "VITE_CUI_THEME=dark vitest run --project storybook"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "react-is": {
      "optional": true
    }
  }
}
